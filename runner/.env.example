# Copy to .env, fill in, then restrict it:   chmod 600 .env
# Never commit .env or paste its contents anywhere.

# Your GitHub username (or org) and the PRIVATE repo this runner serves
GITHUB_OWNER=your-username
GITHUB_REPO=your-private-repo

# "Runner token": fine-grained personal access token
#   - Repository access: Only select repositories -> this repo only
#   - Repository permissions: Administration -> Read and write (nothing else)
#   - Expiration: 90 days or less (set a calendar reminder to rotate it)
# The container keeps it in a root-only process; job code never sees it.
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional
RUNNER_NAME=factory-1
RUNNER_LABELS=claude,factory
